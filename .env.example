# Database Connection (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+psycopg://pilot:pilot_password@localhost:5432/pilot

# LLM Provider Configuration (Structured Outputs & Grounded Extraction)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Public Data Sources (Optional personal GitHub token for higher rate limits)
GITHUB_TOKEN=

# Environment: development / test / production
PILOT_ENV=development
